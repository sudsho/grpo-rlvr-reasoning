# Move this to .github/workflows/test.yml once your gh CLI has the
# `workflow` scope (gh auth refresh -s workflow). It runs lint + unit
# tests on every push. The heavy training tests are guarded and skipped.
name: test
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"
      - name: install
        run: |
          python -m pip install --upgrade pip
          # torch is the biggest dep; install cpu-only wheels in CI
          pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu
          pip install -r requirements.txt --no-deps
          pip install -e ".[dev]"
      - name: install firejail
        run: sudo apt-get update && sudo apt-get install -y firejail
      - name: lint
        run: ruff check src tests
      - name: unit tests
        run: pytest -q -x -m "not slow"
